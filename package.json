{
  "name": "dotenv-vscode",
  "displayName": "Dotenv Official",
  "description": "official dotenv extension for vscode—from the creator of dotenv.",
  "author": "Mot @motdotla",
  "version": "1.5.1",
  "license": "MIT",
  "icon": "dotenv.png",
  "galleryBanner": {
    "color": "#ECD53F",
    "theme": "light"
  },
  "qna": false,
  "engines": {
    "vscode": "^1.65.0"
  },
  "categories": [
    "Languages"
  ],
  "activationEvents": [
    "*",
    "onCustomEditor:dotenv.sourceEditor"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Dotenv Official",
      "properties": {
        "dotenv.dotenvxPath": {
          "scope": "machine-overridable",
          "type": "string",
          "default": "dotenvx",
          "description": "Path to the dotenvx executable used to decrypt values in the Dotenv Editor."
        },
        "dotenv.enableAutocloaking": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Enable auto-cloaking for your .env files"
        },
        "dotenv.enableSecretpeeking": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Enable in-code secret peeking for your environment variables"
        },
        "dotenv.cloakColor": {
          "scope": "resource",
          "type": "string",
          "default": "#000000",
          "description": "Change the color of the cloak for your .env files"
        },
        "dotenv.cloakIcon": {
          "scope": "resource",
          "type": "string",
          "default": "█",
          "description": "Change the icon of the cloak for your .env files"
        },
        "dotenv.yamlSections": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "default": [
            "env_variables",
            "environment",
            "env"
          ],
          "description": "YAML section names whose environment values are cloaked in the normal YAML editor. Use an empty array to disable YAML cloaking."
        }
      }
    },
    "languages": [
      {
        "id": "dotenv",
        "aliases": [
          "Dotenv",
          ".env",
          "env",
          "environment variables"
        ],
        "extensions": [
          ".env",
          ".flaskenv"
        ],
        "configuration": "./syntaxes/language-configuration.json",
        "filenamePatterns": [
          ".env*"
        ]
      }
    ],
    "grammars": [
      {
        "language": "dotenv",
        "scopeName": "source.dotenv",
        "path": "./syntaxes/dotenv.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "dotenv.toggleAutocloaking",
        "category": "Dotenv",
        "title": "Toggle auto-cloaking"
      }
    ],
    "customEditors": [
      {
        "viewType": "dotenv.sourceEditor",
        "displayName": "Dotenv Editor",
        "selector": [
          {
            "filenamePattern": "**/{.env*,*.env,.flaskenv,.dev.vars*,.env.d/*}"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "lint": "standard --fix",
    "pretest": "npm run lint",
    "test": "npm run build:editor && node ./test/runTest.js",
    "package": "npm run lint && vsce package",
    "install-package": "code --install-extension",
    "login": "vsce login",
    "publish": "npm install && npm run lint && vsce package && vsce publish",
    "build:editor": "node scripts/build-editor.js",
    "vscode:prepublish": "npm run build:editor"
  },
  "publisher": "dotenv",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.1",
    "@types/vscode": "1.65.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "mocha": "^12.0.2",
    "monaco-editor": "^0.56.0",
    "ovsx": "1.2.0",
    "standard": "^17.1.2",
    "typescript": "^7.0.2"
  },
  "standard": {
    "ignore": [
      "/test/suite/examples/**",
      "/media/editor/dist/**"
    ]
  },
  "keywords": [
    "dotenv",
    "environment variables",
    "env",
    ".env",
    "environment",
    "variables",
    "config",
    "settings",
    "official",
    "development",
    "productivity",
    "secrets",
    "cloak",
    "mask",
    "hide",
    "blur"
  ],
  "dependencies": {
    "dotenv": "^18.0.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.15"
    }
  },
  "homepage": "https://github.com/dotenvx/dotenv-vscode",
  "bugs": {
    "url": "https://github.com/dotenvx/dotenv-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dotenvx/dotenv-vscode.git"
  }
}
